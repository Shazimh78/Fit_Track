# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net
MONGO_DB_NAME=gym_app

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email — Brevo's HTTP API (free 300/day forever, no card, no domain needed).
# Sign up at brevo.com, verify a sender email under Senders & IPs, then
# create an API key under SMTP & API > API Keys.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Fit-Track

# OTP
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Gemini (exercise descriptions + chatbot) — free tier, get a key at aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# YouTube Data API v3 — free 10,000 units/day, from console.cloud.google.com
YOUTUBE_API_KEY=your-youtube-api-key

# Comma-separated frontend URLs allowed to call this API (no spaces).
# Local dev only needs the first one; add your deployed frontend URL when
# you deploy, e.g. http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
